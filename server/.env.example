# Server Port (Default: 3000 for local dev, 10000 for Render)
PORT=3000

# CORS Allowed Origin (Default: * or your Vercel frontend URL)
CORS_ORIGIN=*

# Optional: Supabase PostgreSQL Persistence (if syncing rooms to database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
